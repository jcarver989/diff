{
  "mcps": [".aether/mcp.json"],
  "agents": [
    {
      "name": "Orchestrator",
      "description": "Routes GitHub issues to sub-agents based on task complexity",
      "model": "zai:glm-5.3",
      "reasoningEffort": "high",
      "userInvocable": true,
      "agentInvocable": false,
      "prompts": [".aether/agents/orchestrator.md", "AGENTS.md"]
    },
    {
      "name": "Planner",
      "description": "Don't spawn unless explicitly asked to",
      "model": "zai:glm-5.3",
      "reasoningEffort": "high",
      "userInvocable": true,
      "agentInvocable": true,
      "prompts": [".aether/SYSTEM.md", ".aether/agents/planner.md", "AGENTS.md"]
    },
    {
      "name": "Complex Builder",
      "description": "Don't spawn unless explicitly asked to",
      "model": "zai:glm-5.3",
      "reasoningEffort": "high",
      "userInvocable": true,
      "agentInvocable": true,
      "prompts": [".aether/agents/builder.md", "AGENTS.md"]
    },
    {
      "name": "Simple Builder",
      "description": "Don't spawn unless explicitly asked to",
      "model": "zai:glm-5.3-flash",
      "reasoningEffort": "high",
      "userInvocable": true,
      "agentInvocable": true,
      "prompts": [".aether/agents/builder.md", "AGENTS.md"],
      "mcps": [".aether/mcp.json"]
    },
    {
      "name": "Explorer",
      "description": "Explores codebases to find relevant files, patterns, and integration points",
      "model": "zai:glm-5.3-flash",
      "userInvocable": false,
      "agentInvocable": true,
      "prompts": [".aether/agents/explorer.md"],
      "mcps": [
        {
          "type": "inline",
          "servers": {
            "coding": {
              "type": "in-memory",
              "args": [
                "--rules-dir",
                "${HOME}/.claude/rules",
                "--rules-dir",
                "${WORKSPACE}/.claude/rules",
                "--rules-dir",
                "${HOME}/.agents/rules",
                "--rules-dir",
                "${WORKSPACE}/.agents/rules"
              ],
              "input": null
            }
          }
        }
      ],
      "tools": {
        "allow": [{ "readOnly": true }, "plan__*", "skills__*", "subagents__*", "tasks__*", "survey__*"]
      }
    }
  ]
}
