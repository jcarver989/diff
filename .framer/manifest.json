{
  "files": {
    ".config/nextest.toml": {
      "kind": "managed"
    },
    ".github/dependabot.yml": {
      "kind": "managed"
    },
    ".github/workflows/ci.yml": {
      "kind": "managed"
    },
    ".github/workflows/release-plz.yml": {
      "kind": "managed"
    },
    ".gitignore": {
      "kind": "blocks",
      "ids": [
        "framer",
        "rust-monorepo"
      ]
    },
    "Cargo.toml": {
      "kind": "toml",
      "keys": [
        "workspace.resolver",
        "workspace.members",
        "workspace.package.edition",
        "workspace.package.license",
        "workspace.package.repository",
        "workspace.package.rust-version",
        "workspace.lints",
        "profile.dev",
        "profile.dist",
        "workspace.dependencies.rouge",
        "workspace.dependencies.rouge-core",
        "workspace.dependencies.rouge-reactive",
        "workspace.dependencies.rouge-widgets",
        "workspace.dependencies.rouge-theme",
        "workspace.dependencies.rouge-syntax",
        "workspace.dependencies.rouge-markdown",
        "workspace.dependencies.clankerdiff-fingerprint.path",
        "workspace.dependencies.clankerdiff-lspd.path",
        "workspace.dependencies.clankerdiff-ui-core.path",
        "workspace.dependencies.clankerdiff-core.path",
        "workspace.dependencies.clankerdiff-protocol.path",
        "workspace.dependencies.clankerdiff-client.path",
        "workspace.dependencies.clankerdiff-git.path",
        "workspace.dependencies.clankerdiff-watch.path",
        "workspace.dependencies.clankerdiff-server.path",
        "workspace.dependencies.clankerdiff-markdown.path",
        "workspace.dependencies.clankerdiff-symbols.path",
        "workspace.dependencies.clankerdiff-rouge.path",
        "workspace.dependencies.clankerdiff-ratatui.path",
        "workspace.dependencies.clankerdiff-desktop.path",
        "workspace.dependencies.clankerdiff-remote",
        "workspace.dependencies.clankerdiff-web",
        "workspace.dependencies.open",
        "workspace.dependencies.pulldown-cmark",
        "workspace.dependencies.schemars",
        "workspace.dependencies.tree-sitter"
      ]
    },
    "clippy.toml": {
      "kind": "managed"
    },
    "dist-workspace.toml": {
      "kind": "managed"
    },
    "mise.toml": {
      "kind": "toml",
      "keys": [
        "tools",
        "tasks.check",
        "tasks.test",
        "tasks.test-ci",
        "tasks.lint",
        "tasks.fmt",
        "tasks.fmt-check",
        "tasks.doc-check",
        "tasks.framer",
        "tasks.framer-check",
        "tasks.dist-plan",
        "tasks.dist-generate",
        "tasks.dist-check"
      ]
    },
    "release-plz.toml": {
      "kind": "toml",
      "keys": [
        "workspace.release_always",
        "workspace.git_release_enable",
        "workspace.git_tag_name",
        "workspace.pr_branch_prefix",
        "workspace.pr_name",
        "workspace.dependencies_update",
        "workspace.release",
        "workspace.git_only",
        "workspace.publish",
        "workspace.semver_check",
        "package"
      ]
    },
    "rust-toolchain.toml": {
      "kind": "managed"
    },
    "rustfmt.toml": {
      "kind": "managed"
    }
  }
}
