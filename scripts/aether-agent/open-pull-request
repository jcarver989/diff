#!/usr/bin/env bash

set -euo pipefail

if [[ -n "$(gh pr list --head "$BRANCH" --state open --json number --jq '.[0].number // ""')" ]]; then
    exit 0
fi

labels=$(gh label list --limit 1000 --json name)
for label in aether automated; do
    if ! jq -e --arg name "$label" 'any(.[]; .name == $name)' <<< "$labels" > /dev/null; then
        gh label create "$label"
    fi
done

body="$RUNNER_TEMP/pr-body.md"
printf 'Closes #%s\n\n' "$NUMBER" > "$body"

draft=()
if [[ "$MODE" == "plan" ]]; then
    title="plan: $ISSUE_TITLE"
    draft=(--draft)
    printf 'Aether planned issue #%s. Review the plan inline, start a reply with `/aether` to revise it,\n' \
        "$NUMBER" >> "$body"
    printf 'and comment `/aether implement-plan` to build it on this branch.\n\n' >> "$body"
else
    title="$SUBJECT"
    printf 'Opened by Aether from issue #%s.\n\n' "$NUMBER" >> "$body"
fi
printf 'Run: %s\n' "$RUN_URL" >> "$body"

gh pr create \
    --base "$BASE" \
    --head "$BRANCH" \
    --title "$title" \
    --body-file "$body" \
    --label aether \
    --label automated \
    "${draft[@]}"
